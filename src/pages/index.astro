---
import Layout from '../layouts/Layout.astro';
import FacebookIcon from '../assets/facebook.svg';
import InstagramIcon from '../assets/instagram.svg';
import EnvelopeIcon from '../assets/envelope.svg';
import BannerImage from '../assets/banner_image.png';
import CertificateIcon from "../assets/certificate.svg";
import BuildingIcon from "../assets/building.svg";
import ProposalSection from "../components/sections/index/Proposal.astro";
---

<Layout>
	<section class="banner">
		<div class="container">
			<div class="banner__info">
				<h1 class="banner__title">Educación <span>virtual y presencial</span>, a tu ritmo.</h1>
				<p class="banner_para">Bachillerato Semipresencial, Técnicas Laborales y cursos.</p>
				<div class="banner_buttons">
					<a class="banner__button_start" href="#">Empezar</a>
					<a href="#" class="social__button">
						<img src={FacebookIcon.src} alt="Facebook icono">
					</a>
					<a href="#" class="social__button">
						<img src={InstagramIcon.src} alt="Facebook icono">
					</a>
					<a href="#" class="social__button">
						<img src={EnvelopeIcon.src} alt="Facebook icono">
					</a>
				</div>
				<p class="banner__conv">Escuela superior de estudio en convenio con politécnico San Marcos.</p>
				<img class="banner__img" src={BannerImage.src} alt="banner image">
			</div>
		</div>
	</section>
	
	<div class="container banner__data">
		<article class="banner__card">
			<div class="banner__card-img">
				<figure>
					<img src={CertificateIcon.src} alt="Cerificate icon">
				</figure>
			</div>
			<h3 class="banner__data-title">+ 20.000</h3>
			<p class="banner__data-para">Estudiantes graduados</p>
		</article>
		<article class="banner__card">
			<div class="banner__card-img">
				<figure style="background-color: brown;">
					<img src={BuildingIcon.src} alt="Cerificate icon">
				</figure>
			</div>
			<h3 class="banner__data-title">+ 20.000</h3>
			<p class="banner__data-para">Estudiantes graduados</p>
		</article>
		<article class="banner__card">
			<div class="banner__card-img">
				<figure style="background-color: #201543;">
					<img src={CertificateIcon.src} alt="Cerificate icon">
				</figure>
			</div>
			<h3 class="banner__data-title">+ 20.000</h3>
			<p class="banner__data-para">Estudiantes graduados</p>
		</article>
	</div>

	<main>
		<ProposalSection />
	</main>
</Layout>

<style>
	.banner {
		position: relative;
		min-height: 75vh;
		width: 100%;
		background-color: var(--second-color-bg);
		color: rgb(224, 224, 224);
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-image: url("../assets/banner_image.png");
		background-repeat: no-repeat;
		background-position: right;
		padding-bottom: 2em;
	}

	.banner__info {
		width: 50%;
	}

	.banner__title {
		font-size: 4.2vw;
		margin-bottom: 0.1em;
	}

	.banner__title span {
		color: var(--second-color);
	}

	.banner_para {
		margin-bottom: 1.5em;
		font-size: 1.2em;
		width: 90%;
	}

	.banner__button_start {
		color: white;
		font-weight: 500;
		border: 1px solid white;
		padding: 0.5em 1em;
		border-radius: 5px;
		transition: all 0.2s;
	}

	.banner__button_start:hover {
		background-color: white;
		color: var(--second-color-bg);
	}

	.banner__conv {
		margin-top: 2em;
		color: var(--second-color);
	}

	.banner_buttons {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.social__button  img{
		filter: invert();
		padding: 5px;
		width: 30px;
	}

	.banner__img {
		display: none;
	}

	.banner__data {
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		justify-content: flex-end;
		transform: translateY(-40px);
		margin-bottom: 5em;
	}

	.banner__card {
		background-color: white;
		min-width: 100px;
		min-height: 120px;
		padding: 1em 0.8em;
		border-radius: 1em;
		box-shadow: 1px 4px 10px rgba(0, 0, 0, 0.171);
	}

	.banner__card-img {
		display: flex;
		justify-content: center;
		margin: 1em;
	}

	.banner__card-img figure {
		background-color: var(--second-color-bg);
		border-radius: 50%;
		width: 50px;
		height: 50px;
		padding: 12px;
	}

	.banner__card-img img {
		width: 100%;
	}

	.banner__data-title, .banner__data-para {
		text-align: center;
		margin-bottom: 0.5em;
	}

	.banner__data-title {
		color: var(--second-color-bg);
	}

	.banner__data-para {
		font-weight: 500;
		color: var(--text-third-color);
	}

	@media (max-width: 880px) {
		.banner {
			background-image: none;
			padding: 0;
			align-items: center;
			padding-top: 4em;
		}

		.banner__info {
			margin: 0 auto;
			width: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}

		.banner__title {
			font-size: 7vw;
			text-align: center;
			margin-bottom: 1em;
		}

		.banner_para {
			text-align: center;
		}

		.banner__img {
			display: block;
			max-width: 100%;
		}

		.banner__data {
			justify-content: center;
		}
	}
</style>